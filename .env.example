# Copy to .env and pass it with `--env-file .env`. Real environment variables win over the file.

# Privacy tier: local (the default: nothing leaves this machine), own-cloud, or cloud
PRIVDOC_TIER=local

# --- LLM: used in the cloud tier, and in own-cloud only when PRIVDOC_LLM_OWNED=true ----------
# Any OpenAI-compatible chat-completions API that supports JSON-schema output
PRIVDOC_LLM_BASE_URL=https://api.openai.com/v1
PRIVDOC_LLM_API_KEY=
PRIVDOC_LLM_MODEL=gpt-4o-mini
# Re-reads only failed or doubtful pages; leave empty to disable escalation to a second model
PRIVDOC_LLM_ESCALATION_MODEL=gpt-4o
# true only if the endpoint above runs in your own cloud account or on your own servers
PRIVDOC_LLM_OWNED=false
# USD per 1M input/output tokens, from your provider's current price list, e.g. model=0.15/0.60
PRIVDOC_PRICES=

# --- own-cloud OCR: Google Cloud Vision in your own project ----------------------------------
# Either an API key (sent as a header, never in the URL) or an OAuth access token
PRIVDOC_GCV_API_KEY=
PRIVDOC_GCV_ACCESS_TOKEN=
PRIVDOC_GCV_QUOTA_PROJECT=
PRIVDOC_GCV_ENDPOINT=https://vision.googleapis.com
PRIVDOC_OCR_LANG=en
# USD per page, from the provider's current price list
PRIVDOC_OCR_PRICE_PER_PAGE=

# --- local OCR ------------------------------------------------------------------------------
PRIVDOC_TESSERACT_CMD=tesseract
PRIVDOC_TESSERACT_LANG=eng

# --- behaviour ------------------------------------------------------------------------------
PRIVDOC_CACHE=on
# default: $XDG_CACHE_HOME/privdoc or ~/.cache/privdoc
PRIVDOC_CACHE_DIR=
PRIVDOC_CACHE_TTL_DAYS=30
PRIVDOC_MAX_PAGES=20
PRIVDOC_MAX_ESCALATIONS=3
PRIVDOC_MAX_FILE_MB=50
PRIVDOC_MIN_TEXT_CHARS=30
PRIVDOC_SCAN_COVER=0.6
PRIVDOC_CONCURRENCY=4
PRIVDOC_TIMEOUT=300
PRIVDOC_FETCH_TIMEOUT=30
PRIVDOC_FETCH_MAX_MB=25
# How to read 04/03/2026 when both parts could be the month: MDY or DMY
PRIVDOC_DATE_ORDER=MDY
